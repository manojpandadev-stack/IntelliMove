{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Services Up",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 8 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(up{job=~\"intellimove-.*\"})",
          "legendFormat": "Healthy",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Total HTTP Requests",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_count{job=~\"intellimove-.*\"}[1h]))",
          "legendFormat": "Requests/hour",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Rate %",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 5 },
              { "color": "red", "value": 20 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_seconds_count{job=~\"intellimove-.*\", status=~\"[45]..\"}[5m])) / sum(rate(http_server_requests_seconds_count{job=~\"intellimove-.*\"}[5m])) * 100",
          "legendFormat": "Error Rate",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Avg Response Time (p95)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.5 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=~\"intellimove-.*\"}[5m])))",
          "legendFormat": "p95",
          "refId": "A"
        }
      ]
    },
    {
      "title": "HTTP Request Rate by Service",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "sum by (job) (rate(http_server_requests_seconds_count{job=~\"intellimove-.*\"}[5m]))",
          "legendFormat": "{{job}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "HTTP Response Time by Service (p50/p95/p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (job, le) (rate(http_server_requests_seconds_bucket{job=~\"intellimove-.*\"}[5m])))",
          "legendFormat": "{{job}} p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate(http_server_requests_seconds_bucket{job=~\"intellimove-.*\"}[5m])))",
          "legendFormat": "{{job}} p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (job, le) (rate(http_server_requests_seconds_bucket{job=~\"intellimove-.*\"}[5m])))",
          "legendFormat": "{{job}} p99",
          "refId": "C"
        }
      ]
    },
    {
      "title": "HTTP Status Codes Distribution",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=~\"intellimove-.*\"}[5m]))",
          "legendFormat": "HTTP {{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "JVM Heap Memory (by service)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\", job=~\"intellimove-.*\"}) / 1024 / 1024",
          "legendFormat": "{{job}} used (MB)",
          "refId": "A"
        },
        {
          "expr": "sum by (job) (jvm_memory_max_bytes{area=\"heap\", job=~\"intellimove-.*\"}) / 1024 / 1024",
          "legendFormat": "{{job}} max (MB)",
          "refId": "B"
        }
      ]
    },
    {
      "title": "JVM GC Pause Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(jvm_gc_pause_seconds_sum{job=~\"intellimove-.*\"}[5m])",
          "legendFormat": "{{job}} {{action}}",
          "refId": "A"
        }
      ]
    },
    {
      "title": "JVM Threads",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "jvm_threads_live_threads{job=~\"intellimove-.*\"}",
          "legendFormat": "{{job}} live",
          "refId": "A"
        },
        {
          "expr": "jvm_threads_daemon_threads{job=~\"intellimove-.*\"}",
          "legendFormat": "{{job}} daemon",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Database Connections (HikariCP)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "targets": [
        {
          "expr": "hikaricp_connections_active{job=~\"intellimove-.*\"}",
          "legendFormat": "{{job}} active",
          "refId": "A"
        },
        {
          "expr": "hikaricp_connections_pending{job=~\"intellimove-.*\"}",
          "legendFormat": "{{job}} pending",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Cache Operations (Redis)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "targets": [
        {
          "expr": "sum by (job) (rate(cache_gets_total{job=~\"intellimove-.*\"}[5m]))",
          "legendFormat": "{{job}} gets/s",
          "refId": "A"
        },
        {
          "expr": "sum by (job) (rate(cache_puts_total{job=~\"intellimove-.*\"}[5m]))",
          "legendFormat": "{{job}} puts/s",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Service Uptime Table",
      "type": "table",
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 36 },
      "targets": [
        {
          "expr": "up{job=~\"intellimove-.*\"}",
          "legendFormat": "{{job}}",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "job": "Service",
              "Value": "Status"
            }
          }
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "tags": ["intellimove", "monitoring"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "IntelliMove Overview",
  "uid": "intellimove-overview",
  "version": 2
}