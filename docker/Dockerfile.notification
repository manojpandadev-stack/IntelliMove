FROM maven:3.9-eclipse-temurin-21 AS builder
WORKDIR /app
COPY pom.xml .
COPY intellimove-common/pom.xml intellimove-common/
COPY intellimove-notification/pom.xml intellimove-notification/
RUN mvn dependency:go-offline -pl intellimove-notification -am 2>/dev/null || true
COPY . .
RUN mvn clean package -DskipTests -pl intellimove-notification -am

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*
RUN groupadd -r appuser && useradd -r -g appuser appuser
COPY --from=builder /app/intellimove-notification/target/*.jar app.jar
RUN chown -R appuser:appuser /app
USER appuser
EXPOSE 8087
HEALTHCHECK --interval=30s --timeout=10s --retries=3 \
  CMD curl -sf http://localhost:8087/actuator/health || exit 1
ENTRYPOINT ["java", "-jar", "app.jar"]
