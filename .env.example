# ============================================================
# IntelliMove — Environment Variables Template
# Copy to .env and fill in values. Never commit .env.
# ============================================================

# ── PostgreSQL ──
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=intellimove
POSTGRES_USER=intellimove
POSTGRES_PASSWORD=changeme_postgres

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Kafka ──
KAFKA_BROKERS=localhost:9092

# ── JWT ──
# IMPORTANT: Must be at least 32 characters for HMAC-SHA256
JWT_SECRET=changeme_jwt_secret_min_32_chars_long!!
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# ── Service Ports ──
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
DRIVER_SERVICE_PORT=8083
RIDE_SERVICE_PORT=8084
LOCATION_SERVICE_PORT=8085
PAYMENT_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
AI_OPS_SERVICE_PORT=8088
GATEWAY_PORT=8080

# ── AI / LLM ──
# Set LLM_ENABLED=true when you have sufficient RAM for Ollama or an API key
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# OpenAI-compatible provider (for OpenAI, Azure OpenAI, etc.)
# SPRING_AI_BASE_URL=https://api.openai.com/v1
# SPRING_AI_API_KEY=sk-your-api-key-here
# SPRING_AI_MODEL=gpt-4o

# ── Email (SMTP) ──
# Configure for production email notifications
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@intellimove.com

# ── Payment ──
# Default: sandbox (always succeeds)
# For production: set PAYMENT_PROVIDER=stripe and configure keys
PAYMENT_PROVIDER=sandbox
# STRIPE_API_KEY=sk_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx

# ── Frontend ──
VITE_API_BASE_URL=http://localhost:8080

# ── Monitoring ──
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin

# ── Kubernetes ──
# Uncomment for K8s deployment
# POSTGRES_HOST=postgres
# REDIS_HOST=redis
# KAFKA_BROKERS=kafka:9092
